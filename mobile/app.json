{
  "expo": {
    "name": "ChurchRide",
    "slug": "churchride",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "churchride",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.wiantribe.churchride",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.wiantribe.churchride",
      "adaptiveIcon": {
        "backgroundColor": "#1D5FD1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1D5FD1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ChurchRide uses your location only when you tap “Save where I am now”, to remember a rider’s exact pickup spot."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
