{
  "expo": {
    "name": "ChurchRide",
    "slug": "churchride",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "churchride",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.wiantribe.churchride",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleSpokenName": "Church Ride",
        "INAlternativeAppNames": [
          {
            "INAlternativeAppName": "Church Ride",
            "INAlternativeAppNamePronunciationHint": "church ride"
          }
        ]
      }
    },
    "android": {
      "package": "com.wiantribe.churchride",
      "adaptiveIcon": {
        "backgroundColor": "#1D5FD1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1D5FD1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "extensionBundleIdentifier": "com.wiantribe.churchride.ShareExtension",
            "appGroupId": "group.com.wiantribe.churchride",
            "activationRule": {
              "supportsText": true,
              "supportsImageWithMaxCount": 10
            }
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ChurchRide uses your location only when you tap “Save where I am now”, to remember a rider’s exact pickup spot."
        }
      ],
      "expo-app-intents"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "inlineModules": {
        "watchedDirectories": [
          "app-intents",
          "screenshot-text"
        ]
      }
    }
  }
}
